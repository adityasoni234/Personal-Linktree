# ============================================================================
# Frontend environment
#
# WARNING: every VITE_* variable is inlined into the JavaScript bundle that is
# shipped to browsers. Everything here is PUBLIC. Never put a database URL, a
# JWT signing secret or a private API key in this file.
# ============================================================================

# Same-origin path. In development the Vite dev server proxies it to the backend
# (see vite.config.ts); in production nginx serves the SPA and the API from one
# origin. Keeping it same-origin is what lets the HttpOnly refresh cookie work.
VITE_API_BASE_URL=/api/v1
VITE_PUBLIC_BASE_URL=http://localhost:5173

# Where the dev proxy forwards /api and /media. Development only.
VITE_DEV_API_TARGET=http://127.0.0.1:8000
