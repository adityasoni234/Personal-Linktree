# ============================================================================
# IEEE SOU Link Hub — environment configuration
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ============================================================================

# ---- Runtime -------------------------------------------------------------
ENVIRONMENT=development           # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false                    # true in production (structured JSON logs)

# ---- Database ------------------------------------------------------------
POSTGRES_USER=linkhub
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=linkhub
DATABASE_URL=postgresql+asyncpg://linkhub:change-me-in-production@postgres:5432/linkhub
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ---- Redis ---------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---- JWT / auth ----------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
PASSWORD_RESET_TTL_MINUTES=30

# ---- Cookies (refresh token + CSRF) --------------------------------------
COOKIE_SECURE=false               # MUST be true in production (HTTPS only)
COOKIE_SAMESITE=lax               # lax | strict | none
COOKIE_DOMAIN=                    # e.g. .linkhub.ieeesou.org (empty = host-only)

# ---- CORS / URLs ---------------------------------------------------------
# Explicit allowlist. NEVER use "*" in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173   # base used when encoding QR target URLs

# ---- Analytics -----------------------------------------------------------
# Pepper used to hash visitor IPs. Raw IPs are never persisted.
ANALYTICS_IP_PEPPER=
ANALYTICS_DEDUPE_WINDOW_SECONDS=1800

# ---- Storage -------------------------------------------------------------
STORAGE_BACKEND=local             # local | s3
STORAGE_LOCAL_DIR=/var/lib/linkhub/media
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/media
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto
STORAGE_ENDPOINT_URL=             # for S3-compatible providers (R2, MinIO, Spaces)

# ---- Uploads -------------------------------------------------------------
MAX_UPLOAD_BYTES=2097152          # 2 MiB
MAX_IMAGE_DIMENSION=4096
MAX_IMAGE_PIXELS=25000000         # decompression-bomb guard

# ---- Rate limiting -------------------------------------------------------
RATE_LIMIT_ENABLED=true

# ---- Bootstrap -----------------------------------------------------------
# Optional: created on first startup if it does not already exist.
BOOTSTRAP_ORG_NAME=IEEE SOU
BOOTSTRAP_ORG_SLUG=ieee-sou
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=

# ---- Frontend (Vite) -----------------------------------------------------
# WARNING: every VITE_* variable is embedded in the browser bundle and is PUBLIC.
# Never put database credentials, JWT secrets, or private API keys here.
#
# Keep the API same-origin with the SPA: the dev server proxies /api to the
# backend, and nginx does the same in production. A cross-origin API would stop
# the SameSite refresh cookie from being sent.
VITE_API_BASE_URL=/api/v1
VITE_PUBLIC_BASE_URL=http://localhost:5173
